# URL canónica del sitio (sin barra final). Cambia esto antes de desplegar.
NEXT_PUBLIC_SITE_URL=https://www.dpgseguros.com
# Endpoint del formulario de contacto (backend Formularyforlanding, envía por MailerSend)
# https://formularyforlanding-production.up.railway.app/api/email/form-submission
NEXT_PUBLIC_FORM_ENDPOINT=
# Google Tag Manager (todo el tracking entra por aquí, no con scripts sueltos)
NEXT_PUBLIC_GTM_ID=
# Verificación de propiedad
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Reseñas reales de Google (Places API New, llamada desde el navegador). Misma key que en
# github.com/mapube16/landingdpg (VITE_GOOGLE_MAPS_API_KEY), restringida por dominio en Google Cloud.
# Sin ella el carrusel muestra las reseñas de muestra de content.ts.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Voz de Aria (Deepgram Aura TTS). Solo se usa al correr `npm run voz:aria`,
# que graba los mp3 en public/audio/aria; el sitio en producción no la necesita.
DEEPGRAM_API_KEY=
# Voz por defecto: aura-2-celeste-es (femenina, español colombiano).
DEEPGRAM_VOZ=
